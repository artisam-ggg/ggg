RPC_URL=<Stellar-Testnet-RPC-URL>
NETWORK_PASSPHRASE=<Stellar-Testnet-network-passphrase>
ESCROW_WASM_HASH=<64-hex-character-uploaded-current-WASM-hash>
TOKEN_SAC_ID=<Testnet-XLM-or-other-token-SAC-contract-ID>
ORGANIZER=<funded-Testnet-G-address>
REFEREE=<different-funded-Testnet-G-address>
PLAYERS=<comma-separated-funded-Testnet-G-addresses-in-rank-order>
DELEGATE=<funded-Testnet-G-address-that-pays-refund-fees>
ENTRY_FEE_STROOPS=<positive-integer>
DISTRIBUTION_BPS=<comma-separated-positive-integers-totaling-10000>
SETTLEMENT_WINDOW_SECONDS=<90-to-7776000-seconds-with-time-for-all-joins>
REFUND_WINDOW_SECONDS=90
SIGNER_MODULE=<absolute-path-to-your-external-signer-module>
