# App
NODE_ENV=development
APP_URL=http://localhost:3000
SESSION_SECRET=            # long random string (>=32 chars) for sessions
CSRF_SECRET=               # long random string (>=32 chars)

# Database / cache
DATABASE_URL=postgresql://ggg:ggg@localhost:5432/ggg
REDIS_URL=redis://localhost:6379

# Seed admin
ADMIN_USERNAME=admin
ADMIN_PASSWORD=            # set locally; never commit a real value

# Stellar
STELLAR_NETWORK=testnet            # testnet | public
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
HORIZON_URL=https://horizon-testnet.stellar.org
NETWORK_PASSPHRASE=Test SDF Network ; September 2015
# Uploaded constructor WASM on Testnet; use a network-specific uploaded hash for other networks.
# #218 uploaded hash only; replace with the verified #219 hash before using this binding.
ESCROW_WASM_HASH=6cd5beaee7382d6033b09b19f741d41e2f499651a3804ad81be0a4ede39c5b72
NATIVE_SAC_ADDRESS=                # native asset contract id for the network
USDC_ISSUER=                       # G-address of the USDC issuer (per network)
USDC_SAC_ADDRESS=                  # the USDC issuer's Stellar Asset Contract id

# File storage (S3 / MinIO)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=ggg-uploads
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true
